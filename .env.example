# Copy to .env.local and fill in AFTER the Sprint 3 Google account is issued
# and a Firebase project has been created with AI Logic enabled
# (Firebase console > AI Services > AI Logic > Get started, Gemini Developer API).
#
# Until then the app runs in on-device-only mode and says so in the UI.
# These are standard Firebase web config values (not private keys), but keep
# real values out of git anyway.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloud model used for the deep clause review (Firebase AI Logic, Gemini Developer API backend)
VITE_GEMINI_CLOUD_MODEL=gemini-2.5-flash
